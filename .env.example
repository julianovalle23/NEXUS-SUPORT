# ===========================================================
# NEXUS Support - variables de entorno
# Copiar a .env (en la raíz del repositorio) y completar. Nunca subir .env al repositorio.
# Spring Boot lee este archivo al arrancar (spring.config.import en application.yml).
# ===========================================================

# --- PostgreSQL (base creada con database/00-crear-base.sql) ---
DB_URL=jdbc:postgresql://localhost:5432/nexus_support
DB_USER=nexus
DB_PASSWORD=cambia_esta_clave

# --- n8n (URL base de los webhooks de la instancia donde se importaron los workflows) ---
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook

# --- Token compartido backend <-> n8n (endpoints internos) ---
# Debe coincidir con la credencial "NEXUS - Token interno" (Header Auth) de n8n.
INTERNAL_API_TOKEN=cambia_este_token_interno

# --- Primera cuenta de administración ---
# Solo se usa si en la base no hay ningún administrador activo con contraseña: al arrancar se crea
# (o se promueve, si el correo ya existe) esa cuenta. Después, las cuentas se gestionan en la página Usuarios
# y cambiar estos valores no modifica la cuenta existente. Contraseña de mínimo 8 caracteres.
NEXUS_ADMIN_CORREO=admin@nexus.local
NEXUS_ADMIN_CLAVE=cambia_esta_clave_admin

# --- Parámetros RAG ---
# Similitud coseno mínima para aceptar un artículo como fuente (ver README, sección "Umbral")
RAG_UMBRAL_SIMILITUD=0.45
RAG_TOP_K=5
RAG_MIN_RESULTADOS=1
RAG_TIMEOUT_SEGUNDOS=60
# Permite ?simularFalloEmbeddings=true para la prueba funcional 8. Usar false en producción.
RAG_PERMITIR_SIMULACION_FALLOS=true

# --- Solo para la calibración del umbral (CalibracionUmbralIT) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
