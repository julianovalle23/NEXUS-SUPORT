    {
      "parameters": {
        "jsCode": "const req = $('Validar solicitud').first().json;\nconst ctx = $input.first().json;\nconst mejor = ctx.mejorSimilitud;\nreturn [{ json: {\n  estado: 'SIN_RESULTADOS',\n  respuesta: 'No se encontró información suficiente en la base de conocimiento para este incidente. ' +\n             `Ningún artículo activo y verificado alcanzó la similitud mínima de ${req.umbral}` +\n             (mejor !== null ? ` (mejor similitud encontrada: ${mejor}).` : '.') +\n             ' Se recomienda escalar el caso y documentar la solución como un nuevo artículo.',\n  pasos: [],\n  fuentes: [],\n  mejorSimilitud: mejor,\n} }];"
      },
      "id": "a5d12115-c0c2-5027-87de-ba91526f3608",
      "name": "Sin fuentes relevantes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
