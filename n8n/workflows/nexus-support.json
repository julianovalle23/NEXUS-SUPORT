    {
      "parameters": {
        "jsCode": "const req = $('Validar solicitud').first().json;\nconst { relevantes, mejorSimilitud } = $('Aplicar umbral').first().json;\nconst validas = new Map(($input.first().json.fuentes || []).map(f => [Number(f.id), f]));\n\n// Solo sobreviven los artículos que existen en la BD y siguen activos y verificados\nconst fuentes = relevantes\n  .filter(r => validas.has(r.articuloId))\n  .map(r => ({ ...r, articulo: validas.get(r.articuloId) }));\n\nconst contexto = fuentes.map((f, i) =>\n  `[Documento ${i + 1}] articuloId=${f.articuloId} | similitud=${f.similitud}\\n` +\n  `Título: ${f.articulo.titulo}\\nProblema: ${f.articulo.problema}\\nSíntomas: ${f.articulo.sintomas}\\n` +\n  `Causa: ${f.articulo.causa}\\nProcedimiento de solución: ${f.articulo.solucion}`\n).join('\\n\\n');\n\nconst inc = req.incidente;\nconst mensajes = [\n  { role: 'system', content: \"Eres el asistente técnico de la mesa de ayuda NEXUS Support. Reglas obligatorias:\\n1. Usa EXCLUSIVAMENTE la información de los documentos recuperados que se te entregan. No uses conocimiento externo ni inventes comandos, causas, herramientas o procedimientos que no aparezcan en ellos.\\n2. Si ninguno de los documentos describe el problema del incidente, responde con sin_informacion = true y explica en 'motivo' qué información falta. No propongas soluciones en ese caso.\\n3. Los pasos deben provenir de los procedimientos de solución de los documentos, adaptados al incidente.\\n4. En fuentes_usadas incluye solo los articuloId de los documentos que realmente utilizaste.\\n5. Escribe en español, en tono técnico y conciso.\\nResponde únicamente con un objeto JSON con esta forma exacta: {\\\"sin_informacion\\\": boolean, \\\"motivo\\\": string, \\\"solucion\\\": string, \\\"pasos\\\": [string], \\\"fuentes_usadas\\\": [number]}\" },\n  { role: 'user', content:\n      `INCIDENTE\\nTítulo: ${inc.titulo ?? '(sin título)'}\\nCategoría: ${inc.categoria ?? '-'}\\nPrioridad: ${inc.prioridad ?? '-'}\\n` +\n      `Descripción: ${req.pregunta}\\n\\nDOCUMENTOS RECUPERADOS\\n${contexto}` },\n];\n\nreturn [{ json: {\n  suficiente: fuentes.length >= req.minResultados,\n  fuentes,\n  mensajes,\n  mejorSimilitud,\n  descartadasPorBD: relevantes.length - fuentes.length,\n} }];"
      },
      "id": "5fd31f64-0003-518d-a3a3-ae39ca4dc632",
      "name": "Construir contexto",
      "type": "n8n-nodes-base.code",
