      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración').first().json.OPENROUTER_BASE_URL }}/chat/completions",
        "options": {
          "timeout": 90000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Title",
              "value": "NEXUS Support"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $('Configuración').first().json.CHAT_MODEL, temperature: 0.1, max_tokens: 1000, response_format: { type: 'json_object' }, messages: $json.mensajes }) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openRouterApi"
      },
      "id": "e72a3840-120d-5492-8586-7bfedcbf26d3",
      "name": "Generar respuesta (OpenRouter)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2700,
        420
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "openRouterApi": {
          "id": "PvE6hq2SBOSib0Da",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Construir contexto').first().json;\nconst r = $input.first().json;\nconst contenido = r.choices?.[0]?.message?.content;\nif (!contenido) {\n  throw new Error('El modelo no devolvió contenido: ' + JSON.stringify(r.error || r).slice(0, 300));\n}\nlet salida;\ntry {\n  salida = JSON.parse(contenido.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, ''));\n} catch (e) {\n  throw new Error('La respuesta del modelo no es JSON válido');\n}\n\nconst permitidos = new Set(ctx.fuentes.map(f => f.articuloId));\nconst usadas = new Set((salida.fuentes_usadas || []).map(Number).filter(id => permitidos.has(id)));\n\nif (salida.sin_informacion === true || !salida.solucion) {\n  return [{ json: {\n    estado: 'SIN_RESULTADOS',\n    respuesta: 'Los documentos recuperados no contienen información suficiente para resolver este incidente. ' +\n               (salida.motivo || ''),\n    pasos: [],\n    fuentes: [],\n    mejorSimilitud: ctx.mejorSimilitud,\n    modelo: r.model,\n  } }];\n}\n\nreturn [{ json: {\n  estado: 'RESPONDIDA',\n  respuesta: salida.solucion,\n  pasos: Array.isArray(salida.pasos) ? salida.pasos.map(String) : [],\n  fuentes: ctx.fuentes.map(f => ({\n    articuloId: f.articuloId,\n    titulo: f.articulo.titulo,\n    categoria: f.categoria,\n    similitud: f.similitud,\n    usada: usadas.has(f.articuloId),\n  })),\n  mejorSimilitud: ctx.mejorSimilitud,\n  modelo: r.model,\n} }];"
      },
      "id": "705a939d-1667-5c67-8f7b-016ea4e01cf6",
      "name": "Formatear respuesta",
      "type": "n8n-nodes-base.code",
