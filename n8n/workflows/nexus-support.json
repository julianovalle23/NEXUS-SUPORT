        1380,
        520
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json.error || $input.first().json;\nconst mensaje = e.message || e.description || JSON.stringify(e).slice(0, 300);\nreturn [{ json: { estado: 'ERROR', etapa: 'EMBEDDINGS', mensaje: 'Falló el servicio de embeddings: ' + mensaje } }];"
      },
