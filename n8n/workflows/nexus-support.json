        "jsonBody": "={{ JSON.stringify({ model: $('Configuración').first().json.EMBEDDING_MODEL, input: $('Detectar cambios').first().json.upserts.map(a => a.texto) }) }}",
        "authentication": "predefinedCredentialType",
