    {
      "parameters": {
        "jsCode": "const cambios = $('Detectar cambios').first().json;\nconst puntos = $('Construir puntos').first().json;\nreturn [{ json: {\n  estado: 'OK',\n  vectorizados: cambios.upserts.map(a => a.id),\n  eliminados: cambios.eliminar,\n  sinCambios: cambios.sinCambios,\n  totalArticulos: cambios.totalArticulos,\n  dimension: puntos.dimension,\n  modeloEmbeddings: puntos.modelo,\n} }];"
      },
