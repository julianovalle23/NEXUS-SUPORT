    {
      "parameters": {
        "jsCode": "const { upserts } = $('Detectar cambios').first().json;\nconst respuesta = $input.first().json;\nconst data = (respuesta.data || []).slice().sort((a, b) => (a.index ?? 0) - (b.index ?? 0));\nif (data.length !== upserts.length) {\n  throw new Error(`OpenRouter devolvió ${data.length} embeddings para ${upserts.length} artículos: ` +\n                  JSON.stringify(respuesta.error || respuesta).slice(0, 300));\n}\nconst ahora = new Date().toISOString();\nconst points = upserts.map((a, i) => ({\n  id: Number(a.id),                 // id del artículo => upsert idempotente, sin duplicados\n  vector: data[i].embedding,\n  payload: {\n    articulo_id: Number(a.id),\n    titulo: a.titulo,\n    categoria: a.categoria,\n    hash: a.hash,\n    fuente_valida: true,\n    indexado_en: ahora,\n  },\n}));\nreturn [{ json: { points, dimension: points[0].vector.length, modelo: respuesta.model } }];"
      },
