    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst vector = r.data?.[0]?.embedding;\nif (!Array.isArray(vector) || vector.length === 0) {\n  throw new Error('El servicio de embeddings no devolvió un vector: ' + JSON.stringify(r.error || r).slice(0, 300));\n}\nreturn [{ json: { vector, modelo: r.model } }];"
      },
      "id": "fbde1e9a-702d-5a87-9894-c106b7a6d0ad",
      "name": "Verificar embedding",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
