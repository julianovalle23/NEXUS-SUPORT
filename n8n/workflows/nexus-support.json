    {
      "parameters": {
        "jsCode": "// Compara los artículos de la base relacional con los puntos ya indexados.\nconst articulos = $('Obtener artículos (Spring Boot)').first().json.articulos || [];\nconst puntos = $input.first().json.result?.points || [];\nconst forzar = $('Webhook indexación').first().json.body?.forzar === true;\n\nconst hashIndexado = new Map(puntos.map(p => [Number(p.id), p.payload?.hash ?? null]));\nconst idsEnBD = new Set();\nconst upserts = [];\nconst eliminar = [];\nlet sinCambios = 0;\n\nfor (const a of articulos) {\n  const id = Number(a.id);\n  idsEnBD.add(id);\n  const indexado = hashIndexado.has(id);\n  if (!a.fuenteValida) {            // inactivo o no verificado: no debe ser fuente\n    if (indexado) eliminar.push(id);\n    continue;\n  }\n  if (!forzar && indexado && hashIndexado.get(id) === a.hash) {\n    sinCambios++;                    // mismo contenido: no se vuelve a vectorizar\n    continue;\n  }\n  upserts.push(a);\n}\n// Puntos huérfanos (artículos que ya no existen en la base relacional)\nfor (const id of hashIndexado.keys()) {\n  if (!idsEnBD.has(id)) eliminar.push(id);\n}\n\nreturn [{ json: { upserts, eliminar, sinCambios, totalArticulos: articulos.length } }];"
      },
