    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst pregunta = String(b.pregunta ?? '').trim();\nconst umbral = Number(b.umbral ?? 0.45);\n// RF04: recuperar entre 3 y 5 soluciones\nconst topK = Math.min(Math.max(Number(b.topK ?? 5), 3), 5);\nconst minResultados = Math.max(Number(b.minResultados ?? 1), 1);\nconst incidente = b.incidente || {};\nreturn [{ json: {\n  valido: pregunta.length > 0 && umbral >= 0 && umbral <= 1,\n  consultaId: b.consultaId ?? null,\n  pregunta,\n  textoBusqueda: incidente.titulo ? `${incidente.titulo}. ${pregunta}` : pregunta,\n  incidente,\n  umbral,\n  topK,\n  minResultados,\n  simularFalloEmbeddings: b.simularFalloEmbeddings === true,\n} }];"
      },
