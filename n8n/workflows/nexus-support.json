    },
    {
      "parameters": {
        "jsCode": "const req = $('Validar solicitud').first().json;\nconst puntos = $input.first().json.result?.points || [];\nconst candidatos = puntos.map(p => ({\n  articuloId: Number(p.payload?.articulo_id ?? p.id),\n  titulo: p.payload?.titulo,\n  categoria: p.payload?.categoria,\n  // similitud coseno acotada a [0, 1]\n  similitud: Math.round(Math.min(Math.max(p.score, 0), 1) * 10000) / 10000,\n}));\nconst relevantes = candidatos.filter(c => c.similitud >= req.umbral);\nreturn [{ json: {\n  candidatos,\n  relevantes,\n  ids: relevantes.map(r => r.articuloId),\n  mejorSimilitud: candidatos.length ? candidatos[0].similitud : null,\n} }];"
      },
