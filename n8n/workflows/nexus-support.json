    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json.error || $input.first().json;\nreturn [{ json: { estado: 'ERROR', etapa: 'QDRANT', mensaje: 'Falló la búsqueda vectorial: ' + (e.message || JSON.stringify(e).slice(0, 300)) } }];"
      },
      "id": "6635151e-806e-5158-9e90-8538d18c0c7e",
      "name": "Error en Qdrant",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        820
